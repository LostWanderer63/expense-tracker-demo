# Copy to .env and fill in. Never commit .env.

# ---- Server ----
NODE_ENV=development
PORT=3000
# Public URL of the app (used in password-reset emails and payment redirects)
APP_URL=http://localhost:3000
# Comma-separated allowed origins. Empty = allow all (frontend is same-origin anyway)
CORS_ORIGIN=

# ---- Database (MySQL) ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=expense_tracker
# e.g. +05:30. Empty = server's local timezone
DB_TIMEZONE=

# ---- Auth ----
JWT_SECRET=
JWT_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=10
RESET_LINK_TTL_MINUTES=60

# ---- Payments (Cashfree) ----
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# SANDBOX or PRODUCTION
CASHFREE_ENV=SANDBOX
PREMIUM_PRICE=499

# ---- AI category suggestion (Gemini) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# ---- Email (Brevo / Sendinblue) ----
BREVO_API_KEY=
BREVO_API_URL=https://api.brevo.com/v3/smtp/email
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Expense Tracker

# ---- File downloads (AWS S3) ----
# IAM user needs s3:PutObject and s3:GetObject on the bucket (or AmazonS3FullAccess).
# Bucket can stay private; downloads use short-lived signed URLs.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
S3_URL_EXPIRES_SECONDS=300

# ---- Logging ----
# error | warn | info | http | debug  (http includes the request log)
LOG_LEVEL=http
LOG_DIR=logs
